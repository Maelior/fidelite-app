<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Interface Caisse</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:#0f0f0f;min-height:100vh;color:#fff}
.page{display:none;flex-direction:column;min-height:100vh}
.page.active{display:flex}
.header{padding:20px;display:flex;align-items:center;justify-content:space-between;border-bottom:0.5px solid #1f1f1f}
.header-title{font-family:'Syne',sans-serif;font-size:18px;font-weight:800}
.header-sub{font-size:11px;color:#555;margin-top:2px}
.content{padding:20px;flex:1;display:flex;flex-direction:column;gap:14px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:#1a1a1a;border-radius:14px;padding:14px}
.stat-label{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:4px}
.stat-value{font-family:'Syne',sans-serif;font-size:26px;font-weight:800;color:#c8a96e}
.btn-scan{background:#c8a96e;border:none;border-radius:16px;padding:18px;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;width:100%;transition:opacity 0.2s}
.btn-scan:hover{opacity:0.9}
.btn-scan-text{font-family:'Syne',sans-serif;font-size:16px;font-weight:800;color:#1a1a1a}
.section-title{font-size:11px;color:#444;text-transform:uppercase;letter-spacing:0.8px}
.client-list{display:flex;flex-direction:column;gap:8px}
.client-item{background:#1a1a1a;border-radius:14px;padding:12px 14px;display:flex;align-items:center;gap:12px}
.client-av{width:38px;height:38px;border-radius:50%;background:#2a2a2a;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-size:13px;font-weight:800;color:#c8a96e;flex-shrink:0}
.client-info{flex:1}
.client-name{font-size:14px;font-weight:500}
.client-detail{font-size:11px;color:#555;margin-top:1px}
.client-pts{font-family:'Syne',sans-serif;font-size:13px;font-weight:800;color:#c8a96e}
.scanner-page{background:#0f0f0f;padding:20px}
.back-btn{background:#1a1a1a;border:none;border-radius:10px;padding:8px 14px;color:#fff;font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer;margin-bottom:20px;display:flex;align-items:center;gap:6px}
.page-title{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;margin-bottom:6px}
.page-sub{font-size:13px;color:#555;margin-bottom:20px}
.qr-frame{background:#1a1a1a;border-radius:20px;padding:20px;display:flex;flex-direction:column;align-items:center;gap:16px;margin-bottom:16px}
.qr-window{width:200px;height:200px;border-radius:16px;background:#0f0f0f;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.qr-corner{position:absolute;width:28px;height:28px;border-color:#c8a96e;border-style:solid;border-width:0}
.qr-corner.tl{top:10px;left:10px;border-top-width:3px;border-left-width:3px;border-radius:4px 0 0 0}
.qr-corner.tr{top:10px;right:10px;border-top-width:3px;border-right-width:3px;border-radius:0 4px 0 0}
.qr-corner.bl{bottom:10px;left:10px;border-bottom-width:3px;border-left-width:3px;border-radius:0 0 0 4px}
.qr-corner.br{bottom:10px;right:10px;border-bottom-width:3px;border-right-width:3px;border-radius:0 0 4px 0}
.scan-line{position:absolute;width:160px;height:2px;background:#c8a96e;opacity:0.7;animation:scanAnim 2s ease-in-out infinite}
@keyframes scanAnim{0%,100%{top:20px}50%{top:170px}}
.qr-hint{font-size:12px;color:#555;text-align:center;line-height:1.5}
.divider{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.divider-line{flex:1;height:0.5px;background:#2a2a2a}
.divider-text{font-size:11px;color:#444}
.input-row{display:flex;gap:8px}
.inp{flex:1;padding:12px 14px;background:#1a1a1a;border:1.5px solid #2a2a2a;border-radius:12px;color:#fff;font-size:14px;font-family:'DM Sans',sans-serif;outline:none}
.inp:focus{border-color:#c8a96e}
.inp::placeholder{color:#444}
.btn-ok{background:#c8a96e;border:none;border-radius:12px;padding:12px 18px;cursor:pointer;font-family:'Syne',sans-serif;font-size:14px;font-weight:800;color:#1a1a1a;transition:opacity 0.2s}
.btn-ok:hover{opacity:0.85}
.confirm-wrap{display:flex;flex-direction:column;align-items:center;padding:20px 0;text-align:center}
.confirm-icon{width:72px;height:72px;border-radius:24px;background:#c8a96e;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.confirm-name{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;margin-bottom:4px}
.confirm-detail{font-size:13px;color:#555;margin-bottom:24px}
.stamps-row{display:flex;gap:6px;margin-bottom:24px;flex-wrap:wrap;justify-content:center}
.cstamp{width:28px;height:28px;border-radius:50%;border:1.5px solid #2a2a2a;display:flex;align-items:center;justify-content:center}
.cstamp.filled{background:#c8a96e;border-color:#c8a96e}
.cstamp.new-stamp{background:#c8a96e;border-color:#c8a96e;animation:popIn 0.4s cubic-bezier(0.34,1.56,0.64,1)}
@keyframes popIn{0%{transform:scale(0)}100%{transform:scale(1)}}
.btn-validate{width:100%;background:#c8a96e;border:none;border-radius:14px;padding:16px;font-family:'Syne',sans-serif;font-size:15px;font-weight:800;color:#1a1a1a;cursor:pointer;margin-bottom:10px;transition:opacity 0.2s}
.btn-validate:hover{opacity:0.85}
.btn-cancel{background:none;border:none;color:#555;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif;padding:8px}
.login-page{display:flex;flex-direction:column;justify-content:center;padding:40px 24px;flex:1}
.field{margin-bottom:14px}
.field label{display:block;font-size:11px;color:#555;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px}
.field input{width:100%;padding:14px;background:#1a1a1a;border:1.5px solid #2a2a2a;border-radius:12px;color:#fff;font-size:15px;font-family:'DM Sans',sans-serif;outline:none}
.field input:focus{border-color:#c8a96e}
.field input::placeholder{color:#444}
.btn-login{width:100%;padding:16px;background:#c8a96e;color:#1a1a1a;border:none;border-radius:14px;font-family:'Syne',sans-serif;font-size:15px;font-weight:800;cursor:pointer;margin-top:8px}
.error{color:#e24b4a;font-size:13px;margin-top:8px;text-align:center}
</style>
</head>
<body>

<div class="page active" id="page-login">
  <div class="login-page">
    <div style="font-family:'Syne',sans-serif;font-size:24px;font-weight:800;margin-bottom:8px" id="login-title">Interface caisse</div>
    <div style="font-size:13px;color:#555;margin-bottom:32px">Connecte-toi pour accéder au panneau commerçant.</div>
    <div class="field"><label>Mot de passe</label><input type="password" id="inp-pwd" placeholder="••••••••" onkeydown="if(event.key==='Enter')doLogin()"></div>
    <button class="btn-login" onclick="doLogin()">Accéder →</button>
    <div class="error" id="login-error" style="display:none">Mot de passe incorrect.</div>
  </div>
</div>

<div class="page" id="page-home">
  <div class="header">
    <div>
      <div class="header-title" id="home-title">Caisse</div>
      <div class="header-sub" id="home-date"></div>
    </div>
    <button style="background:#1a1a1a;border:none;border-radius:8px;padding:6px 12px;color:#555;font-size:12px;cursor:pointer" onclick="doLogout()">Quitter</button>
  </div>
  <div class="content">
    <div class="stats">
      <div class="stat"><div class="stat-label">Visites aujourd'hui</div><div class="stat-value" id="stat-visites">0</div></div>
      <div class="stat"><div class="stat-label">Clients actifs</div><div class="stat-value" id="stat-clients">0</div></div>
    </div>
    <button class="btn-scan" onclick="goPage('page-scanner')">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="3" height="3"/><rect x="19" y="14" width="2" height="2"/><rect x="14" y="19" width="2" height="2"/><rect x="19" y="19" width="2" height="2"/></svg>
      <span class="btn-scan-text">Scanner un client</span>
    </button>
    <div class="section-title">Derniers clients</div>
    <div class="client-list" id="recent-list">
      <div style="font-size:13px;color:#444;text-align:center;padding:20px">Aucune visite aujourd'hui</div>
    </div>
  </div>
</div>

<div class="page" id="page-scanner">
  <div class="scanner-page" style="flex:1">
    <button class="back-btn" onclick="goPage('page-home')">← Retour</button>
    <div class="page-title">Scanner le client</div>
    <div class="page-sub">Le client présente son QR code.</div>
    <div class="qr-frame">
      <div class="qr-window">
        <div class="qr-corner tl"></div><div class="qr-corner tr"></div>
        <div class="qr-corner bl"></div><div class="qr-corner br"></div>
        <div class="scan-line"></div>
      </div>
      <div class="qr-hint">Caméra non disponible en démo<br>Utilise la saisie manuelle ci-dessous</div>
    </div>
    <div class="divider"><div class="divider-line"></div><div class="divider-text">saisir le code manuellement</div><div class="divider-line"></div></div>
    <div class="input-row">
      <input class="inp" type="text" id="inp-code" placeholder="Ex: KEB-A3F2" onkeydown="if(event.key==='Enter')rechercherClient()">
      <button class="btn-ok" onclick="rechercherClient()">OK</button>
    </div>
    <div class="error" id="scanner-error" style="display:none;margin-top:10px">Client introuvable.</div>
  </div>
</div>

<div class="page" id="page-confirm">
  <div style="padding:20px;flex:1">
    <button class="back-btn" onclick="goPage('page-scanner')">← Retour</button>
    <div class="confirm-wrap">
      <div class="confirm-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
      </div>
      <div class="confirm-name" id="conf-name">---</div>
      <div class="confirm-detail" id="conf-detail">---</div>
      <div class="stamps-row" id="conf-stamps"></div>
      <button class="btn-validate" id="btn-validate" onclick="validerTampon()">Valider le tampon ✓</button>
      <button class="btn-cancel" onclick="goPage('page-home')">Annuler</button>
    </div>
  </div>
</div>

<script>
const SUPABASE_URL='https://mlfhbpzyewxxaglisdoy.supabase.co';
const SUPABASE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1sZmhicHp5ZXd4eGFnbGlzZG95Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4MjkwNjAsImV4cCI6MjA5NTQwNTA2MH0.IReZpFo0H2pBDWpZBcIOU5ShHau6O8refG7JcL3oahs';
const MOT_DE_PASSE='caisse1234';
const slug=new URLSearchParams(window.location.search).get('c')||'kebab-royale';
let commerce=null,clientEnCours=null,validated=false,visitesAujourdhui=0;

async function db(path,opts={}){
  const r=await fetch(SUPABASE_URL+'/rest/v1/'+path,{headers:{'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json','Prefer':'return=representation',...opts.headers},...opts});
  return r.json();
}

async function init(){
  const data=await db('commerces?slug=eq.'+slug+'&select=*');
  if(data.length){commerce=data[0];document.getElementById('login-title').textContent=commerce.nom+' · Caisse';}
  document.getElementById('home-date').textContent=new Date().toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long'});
}

function doLogin(){
  const pwd=document.getElementById('inp-pwd').value;
  if(pwd===MOT_DE_PASSE){goPage('page-home');loadStats();}
  else{document.getElementById('login-error').style.display='block';}
}

function doLogout(){goPage('page-login');document.getElementById('inp-pwd').value='';}

async function loadStats(){
  if(!commerce)return;
  const clients=await db('clients?commerce_id=eq.'+commerce.id+'&select=id');
  document.getElementById('stat-clients').textContent=clients.length||0;
  const today=new Date().toISOString().split('T')[0];
  const tampons=await db('tampons?commerce_id=eq.'+commerce.id+'&created_at=gte.'+today+'T00:00:00&select=id');
  visitesAujourdhui=tampons.length||0;
  document.getElementById('stat-visites').textContent=visitesAujourdhui;
  const recents=await db('clients?commerce_id=eq.'+commerce.id+'&order=created_at.desc&limit=5&select=*');
  const list=document.getElementById('recent-list');
  if(recents.length){
    list.innerHTML=recents.map(c=>`<div class="client-item"><div class="client-av">${c.prenom[0]}${c.nom[0]}</div><div class="client-info"><div class="client-name">${c.prenom} ${c.nom}</div><div class="client-detail">${c.tampons} tampons</div></div><div class="client-pts">${c.points} pts</div></div>`).join('');
  }
}

async function rechercherClient(){
  const code=document.getElementById('inp-code').value.trim().toUpperCase();
  if(!code)return;
  document.getElementById('scanner-error').style.display='none';
  const data=await db('clients?code=eq.'+code+'&select=*');
  if(!data.length){document.getElementById('scanner-error').style.display='block';return;}
  clientEnCours=data[0];
  validated=false;
  afficherConfirmation();
  goPage('page-confirm');
}

function afficherConfirmation(){
  const c=clientEnCours;
  const max=commerce?commerce.tampons_max||10:10;
  const t=c.tampons%max;
  document.getElementById('conf-name').textContent=c.prenom+' '+c.nom;
  document.getElementById('conf-detail').textContent=c.points+' pts · '+c.tampons+' tampons au total';
  document.getElementById('btn-validate').textContent='Valider le tampon ✓';
  document.getElementById('btn-validate').style.background='#c8a96e';
  document.getElementById('btn-validate').style.color='#1a1a1a';
  const row=document.getElementById('conf-stamps');
  row.innerHTML='';
  for(let i=0;i<max;i++){
    const d=document.createElement('div');
    d.className='cstamp'+(i<t?' filled':'');
    if(i<t)d.innerHTML='<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
    row.appendChild(d);
  }
}

async function validerTampon(){
  if(validated||!clientEnCours||!commerce)return;
  validated=true;
  document.getElementById('btn-validate').textContent='Validation...';
  const nouveauxTampons=clientEnCours.tampons+1;
  const nouveauxPoints=clientEnCours.points+10;
  await db('clients?id=eq.'+clientEnCours.id,{method:'PATCH',body:JSON.stringify({tampons:nouveauxTampons,points:nouveauxPoints})});
  await db('tampons',{method:'POST',body:JSON.stringify({client_id:clientEnCours.id,commerce_id:commerce.id})});
  clientEnCours.tampons=nouveauxTampons;
  clientEnCours.points=nouveauxPoints;
  const max=commerce.tampons_max||10;
  const t=nouveauxTampons%max;
  const row=document.getElementById('conf-stamps');
  row.innerHTML='';
  for(let i=0;i<max;i++){
    const d=document.createElement('div');
    d.className='cstamp'+(i<t?(i===t-1?' new-stamp':' filled'):'');
    if(i<t)d.innerHTML='<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
    row.appendChild(d);
  }
  document.getElementById('conf-detail').textContent=nouveauxPoints+' pts · '+nouveauxTampons+' tampons au total';
  document.getElementById('btn-validate').textContent='✓ Tampon validé !';
  document.getElementById('btn-validate').style.background='#2a2a2a';
  document.getElementById('btn-validate').style.color='#c8a96e';
  visitesAujourdhui++;
  document.getElementById('stat-visites').textContent=visitesAujourdhui;
  document.getElementById('inp-code').value='';
  setTimeout(()=>{goPage('page-home');loadStats();},2000);
}

function goPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');}

init();
</script>
</body>
</html>
